# ─────────────────────────────────────────────────────────────
# Shadow BackEnd — environment configuration (12-factor)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All of these are read through app/constant.py (the single
# source of truth for keys/config).
# ─────────────────────────────────────────────────────────────

# App
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for MVP; swap DATABASE_URL for PostgreSQL later)
DATABASE_URL=sqlite:///./shadow.db

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM provider ("gemini" for production, "fake" for offline dev/tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# CORS — the FrontEnd origin(s) allowed to call this API.
# Comma-separated. Include your Firebase Hosting URL in production.
CORS_ORIGINS=http://localhost:5173
