# ─────────────────────────────────────────────────────────────
# Shadow BackEnd — environment configuration (12-factor)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All of these are read through app/core/config.py (the single
# source of truth for keys/config).
# ─────────────────────────────────────────────────────────────

# App
ENVIRONMENT=development
DEBUG=true

# Database.
# - Local / MVP default: SQLite (a single file, no server to run).
# - Production durability: use a managed PostgreSQL (automatic backups, no
#   single-file loss risk). Only DATABASE_URL changes — no code changes:
#     DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#   Then apply the schema once with: alembic upgrade head
DATABASE_URL=sqlite:///./shadow.db

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# Public frontend URL used in verification links.
# Link format: <PUBLIC_FRONTEND_BASE_URL>/verify-email?token=...
PUBLIC_FRONTEND_BASE_URL=https://shadow-pa.web.app

# SMTP (optional). If unset, verification links are generated but not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shadow

# LLM provider ("gemini" for production, "fake" for offline dev/tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-7-sonnet

# CORS — the FrontEnd origin(s) allowed to call this API.
# Comma-separated. Include your Firebase Hosting URL in production.
CORS_ORIGINS=http://localhost:5173, https://shadow-pa.web.app

# Optional IP geolocation fallback for new-device alert emails.
# Used only when proxy geo headers are missing.
# Keep disabled unless you explicitly want outbound IP lookup.
IP_GEOLOCATION_ENABLED=false
IP_GEOLOCATION_BASE_URL=http://ip-api.com/json/{ip}?fields=status,country,regionName,city
IP_GEOLOCATION_TIMEOUT_SECONDS=2.5
