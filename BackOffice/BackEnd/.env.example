# ─── BackOffice's own database (separate from Shadow V2's shadow.db) ──────────
DATABASE_URL=sqlite:///./backoffice.db

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
# "none" is required here — the frontend (Firebase Hosting) and this API are
# on different origins, and browsers only send cookies cross-site when
# SameSite=None (which also forces Secure=True, requiring HTTPS).
SAME_SITE=none
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ─── CORS — the BackOffice frontend's origin(s) ────────────────────────────────
CORS_ORIGINS=http://localhost:5200

# ─── Shadow V2 integration ────────────────────────────────────────────────────
# BackOffice runs on the same Termux device as BackEnd_V2 and talks to it over
# localhost. These must point at the real, live paths/ports of that deployment.
SHADOW_BACKEND_DIR=~/shadow/BackEnd_V2
SHADOW_BACKEND_URL=http://127.0.0.1:8000
SHADOW_WEBHOOK_URL=http://127.0.0.1:9000
SHADOW_GIT_REF=refs/heads/R202609/develop
SHADOW_GIT_BRANCH=R202609/develop

# Must match the _ADMIN_SECRET constant in BackEnd_V2/app/api/system.py —
# copy the exact value from that file. Never commit the real value here;
# this file is the template, the real .env is gitignored.
SHADOW_ADMIN_SECRET=

# ─── BackOffice's own admin-protected endpoints ────────────────────────────────
# Checked against X-Admin-Secret on this server's own /admin/sql and
# /admin/database — independent from SHADOW_ADMIN_SECRET above.
ADMIN_SECRET=change-this-in-production

# BackOffice's own repo/branch — checked by POST /restart, its own
# deploy-webhook endpoint (mirrors SHADOW_GIT_REF/SHADOW_GIT_BRANCH, but for
# this repo instead of BackEnd_V2's).
BACKOFFICE_GIT_REF=refs/heads/R202609/backoffice
BACKOFFICE_GIT_BRANCH=R202609/backoffice
