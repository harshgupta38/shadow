# ─── BackOffice's own database (separate from Shadow V2's shadow.db) ──────────
DATABASE_URL=sqlite:///./backoffice.db

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
# Handed to the frontend in the login response body and sent back as an
# Authorization: Bearer header, not a cookie — the frontend (Firebase
# Hosting) and this API are on different origins, and a cookie would be a
# third-party cookie that Chrome Incognito and mobile Safari (ITP) block
# outright regardless of SameSite. No SAME_SITE setting needed anymore.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ─── CORS — the BackOffice frontend's origin(s) ────────────────────────────────
CORS_ORIGINS=http://localhost:5200

# ─── Shadow V2 integration ────────────────────────────────────────────────────
# BackOffice runs on the same Termux device as BackEnd_V2 and reads/writes its
# files (shadow.db, backups/, server.log) directly — see shadow_db_service.py.
# shadow_backend_url is only used for BackEnd_V2's public /health (status +
# restart detection); git/restart/deploy all go through the Control Server
# instead (see below).
SHADOW_BACKEND_DIR=~/shadow/BackEnd_V2
SHADOW_BACKEND_URL=http://127.0.0.1:8000

# ─── BackOffice's own admin-protected endpoints ────────────────────────────────
# REQUIRED — checked against X-Admin-Secret on this server's own /admin/sql
# and /admin/database (arbitrary SQL against backoffice.db) — independent
# from SHADOW_ADMIN_SECRET above. The server refuses to start if this is
# left unset or at the placeholder value below — generate a real one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=change-this-in-production

# REQUIRED — required (alongside an existing admin's own password) to create
# a new BackOffice admin via POST /users/backoffice, a second factor so a
# stolen session cookie alone can't mint new admins. Same startup-refusal
# rule as ADMIN_SECRET above applies.
NEW_ADMIN_SECRET=change-this-in-production

# ─── Control Server integration ────────────────────────────────────────────────
# The Server/ control plane (port 9000) — must match CONTROL_SECRET in
# Server/.env. No branch name lives here; deploy always pulls whatever
# branch is currently checked out unless a caller explicitly requests one.
CONTROL_SERVER_URL=http://127.0.0.1:9000
CONTROL_SECRET=change-this-in-production
