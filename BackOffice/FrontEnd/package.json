{
  "name": "shadow-backoffice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting",
    "deploy-stg": "npm run build:stg && firebase hosting:channel:deploy stg1 --expires 30d",
    "deploy-dev": "npm run build:dev && firebase hosting:channel:deploy dev1 --expires 7d"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.4",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.81.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
