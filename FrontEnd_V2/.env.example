# ── Frontend environment ──────────────────────────────────────────────
# Base URL of the Shadow backend REST API (must include the /api prefix).
# Only VITE_-prefixed variables are exposed to the client — never secrets.
VITE_API_BASE_URL=http://localhost:8000/api

# Axios timeout in seconds.
VITE_API_TIMEOUT_SECONDS=3600
