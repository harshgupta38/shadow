# ── Shadow Control Server ─────────────────────────────────────────────────────
# Every setting below has a working default in app/core/config.py — the server
# runs fine with zero config files. Copy this to .env only if you want to
# override something (most commonly CONTROL_SECRET, since the code default is
# the same on every clone).

# Required in the X-Control-Secret header on every /control, /logs, /db and
# /git request. Must match CONTROL_SECRET in BackOffice/BackEnd/.env too,
# since BackOffice calls this server on an admin's behalf.
CONTROL_SECRET=change-this-in-production

# Absolute or ~ paths to the two managed services on this machine.
MAIN_DIR=~/shadow/BackEnd_V2
BACKOFFICE_DIR=~/shadow/BackOffice/BackEnd

# Ports the managed services listen on (used for health probes).
MAIN_PORT=8000
BACKOFFICE_PORT=8100
